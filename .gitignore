__pycache__/
*.egg-info/
.venv/
build/
dist/

# Reports may contain sensitive values when explicitly requested; never commit them.
*report*.json
samples/audit.json
# Ignore root-level JSON artifacts; committed JSON belongs in a subdirectory.
/*.json
samples/out/

# Generated evaluation artifacts.
tests/corpus/generated/

# Scratch output.
tmp/
masked/
# Common one-off CLI destinations may contain source pixels or identifiers.
/masked-*
/masked_*
/masked.*
/*-masked.*

# Local tool state
.pytest_cache/
.claude/
*.ses
.DS_Store
